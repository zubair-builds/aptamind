{
  "description": "Job lifecycle golden sequences. Each case starts from `start` and applies events in order.",
  "cases": [
    {
      "id": "failed-source-fetch-no-change",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "source_fetch_failed"
        },
        {
          "kind": "source_fetch_failed"
        },
        {
          "kind": "source_fetch_failed"
        }
      ],
      "expect": {
        "state": "VERIFIED_LIVE"
      }
    },
    {
      "id": "removed-from-source-once",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        }
      ],
      "expect": {
        "state": "POSSIBLY_STALE"
      }
    },
    {
      "id": "removed-from-source-twice",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        },
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        }
      ],
      "expect": {
        "state": "POSSIBLY_STALE",
        "consecutiveAbsences": 2
      },
      "note": "Ruling L1: absence alone never closes. Two consecutive absences without a not_found verification leave the job POSSIBLY_STALE (verification is scheduled)."
    },
    {
      "id": "third-party-absence-ignored",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "third_party"
        },
        {
          "kind": "absent_from_listing",
          "authority": "third_party"
        }
      ],
      "expect": {
        "state": "VERIFIED_LIVE"
      }
    },
    {
      "id": "absent-then-back",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        },
        {
          "kind": "seen",
          "authority": "official_ats"
        }
      ],
      "expect": {
        "state": "VERIFIED_LIVE"
      }
    },
    {
      "id": "closed-then-seen-reopened",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        },
        {
          "kind": "verification",
          "outcome": "not_found",
          "absentFromListing": false
        },
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        },
        {
          "kind": "seen",
          "authority": "official_ats"
        }
      ],
      "expect": {
        "state": "REOPENED"
      }
    },
    {
      "id": "repost",
      "start": {
        "authority": "official_ats"
      },
      "events": [
        {
          "kind": "absent_from_listing",
          "authority": "official_ats"
        },
        {
          "kind": "verification",
          "outcome": "not_found",
          "absentFromListing": true
        },
        {
          "kind": "repost_detected"
        }
      ],
      "expect": {
        "state": "REPOSTED",
        "historyTo": ["VERIFIED_LIVE", "POSSIBLY_STALE", "CLOSED", "REPOSTED"]
      },
      "note": "A repost is a new posting of a CLOSED job: the absence and the not_found close it first (re-verify #9 Low 3)."
    },
