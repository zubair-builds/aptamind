      "expect": {
        "provider": "greenhouse",
        "boardToken": "acme-eu",
        "sourceKey": "greenhouse:eu:acme-eu",
        "listingUrl": "https://boards-api.eu.greenhouse.io/v1/boards/acme-eu/jobs?content=true",
        "jobUrl": "https://boards-api.eu.greenhouse.io/v1/boards/acme-eu/jobs/123?pay_transparency=true"
      }
    },
    {
