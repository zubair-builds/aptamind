# Aptamind environment. Copy to .env (never commit real secrets).
# All variables are validated at startup by @aptamind/config (packages/config/src/index.ts).

NODE_ENV=development
LOG_LEVEL=info

# MongoDB — must be a replica set (transactions). Local stack: `pnpm infra:up`.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=aptamind

# Redis / BullMQ (transport only; workflow state lives in MongoDB)
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=aptamind

# S3-compatible object storage. S3_ENDPOINT is REQUIRED: config refuses to start without it, so
# storage can never fall back to real Amazon S3 by accident (FE-3).
# - Local (default below): SeaweedFS from `pnpm infra:up`. These keys are local-only defaults.
# - Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto,
#   and the R2 API token's key id and secret below. Never commit real keys.
# - Amazon S3 on purpose: leave S3_ENDPOINT unset and set S3_USE_AWS_DEFAULT_ENDPOINT=true.
#   Setting both is refused.
# - An explicit S3_ENDPOINT=https://s3.amazonaws.com with static keys is also allowed. It is the
#   only way to reach Amazon S3 besides the opt-in.
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are always required, the opt-in included. The client
# never uses ambient AWS credentials (~/.aws, AWS_PROFILE, instance metadata).
# Scripts do not load this file. Copy it to .env and export it: set -a; . ./.env; set +a
S3_ENDPOINT=http://127.0.0.1:9000
# S3_USE_AWS_DEFAULT_ENDPOINT=false
S3_REGION=us-east-1
S3_BUCKET=aptamind-artifacts
S3_ACCESS_KEY_ID=aptamind
S3_SECRET_ACCESS_KEY=aptamind-dev-secret
S3_FORCE_PATH_STYLE=true

# Internal API — NO AUTHENTICATION in v0.1. Keep it on a private interface.
# No authentication in v0.1: production accepts only an explicit loopback or private-network IP
# (0.0.0.0, ::, public addresses and hostnames are refused; see classifyBindHost).
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Worker
# WORKER_ID=worker-1
WORKER_CONCURRENCY=8
# Comma-separated capability queues to consume (default: default,io,browser,ai)
# WORKER_QUEUES=default,io
WORKER_SCHEDULER_ENABLED=true
WORKER_SCHEDULER_INTERVAL_MS=5000
WORKER_SWEEPER_INTERVAL_MS=15000
WORKER_LEASE_MS=60000
# Worker /health /ready /metrics (localhost only). 0 disables.
WORKER_METRICS_PORT=4101

# Outbound acquisition safety
# Only enable for local fixture servers; refused in production.
NET_ALLOW_PRIVATE_NETWORK=false
NET_USER_AGENT=AptamindMarketBot/0.1 (+internal; contact: ops@aptamind.invalid)
NET_DEFAULT_TIMEOUT_MS=20000
NET_MAX_RESPONSE_BYTES=52428800
NET_PER_HOST_CONCURRENCY=2
NET_PER_HOST_MIN_INTERVAL_MS=250
# redis: one per-host budget shared by every process; memory: one budget per process.
NET_HOST_LIMITER=redis
NET_HOST_LEASE_TTL_MS=120000

# Headless browser for Browser Fetch/Crawl (optional). e.g. a Playwright Chromium binary.
# Chromium always runs sandboxed and behind the worker's egress proxy. For a non-root worker,
# point this at Chromium itself. If the process must run as root (dev containers), use the
# privilege-dropping wrapper instead (never --no-sandbox):
#   BROWSER_EXECUTABLE_PATH=./scripts/chromium-unprivileged.sh
#   CHROMIUM_BIN=/path/to/chrome  CHROMIUM_RUN_AS=aptamind-browser
# BROWSER_EXECUTABLE_PATH=/path/to/chrome

# AI gateway: none | anthropic | gemini | fixture. Without a key the gateway is "unavailable" and
# AI-dependent steps fail visibly; deterministic interpretation keeps working.
AI_PROVIDER=none
AI_MODEL=claude-opus-5
# Name of the env var holding the provider key (credential reference, not the key itself)
AI_API_KEY_ENV=ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=60000
# Google Gemini instead (key from https://aistudio.google.com; free tier is rate limited, so
# consider a low WORKER_CONCURRENCY):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY_ENV=GEMINI_API_KEY
# GEMINI_API_KEY=

# Next.js UI and API origin. Server Actions use this absolute origin for same-origin requests.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
